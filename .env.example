# Copy to .env (never commit .env). Read by docker compose.

# Pin the Hermes image tag. Patch releases roll up hundreds of PRs; bump deliberately.
HERMES_TAG=0.21.5

# Host path of the repos the agent works in (bind-mounted at /workspace). Use a SEPARATE
# clone from your own working copies. Windows example: C:/work/agent-repos
WORKSPACE=C:/work/agent-repos

# Your OpenAI-compatible endpoint (llama-server, vLLM, ...). Must serve native tool calls and
# >= 64k context. The host must also appear in EGRESS_ALLOW below.
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=my-model-alias
LLM_API_KEY=replace-me

# Hostnames the agent may reach through the egress proxy, comma-separated, fnmatch globs
# allowed. Everything else is refused at the proxy (there is no other route out).
#   llm.example.com        the AI endpoint host (same host as LLM_BASE_URL)
#   host.docker.internal   services running on the laptop itself (e.g. the React dev server)
#   *.replica              every service on the replica compose network if you name it so;
#                          or list the service names: api,web,db
EGRESS_ALLOW=llm.example.com,host.docker.internal

# Optional second model: GitHub Copilot as planner/reviewer/judge (local Qwen stays the
# workhorse; every Copilot route falls back to local when credits/quota run out).
# Token: a fine-grained PAT with ONLY the "Copilot Requests" permission (github_pat_...), or a
# gho_ OAuth token. Never a token with repository write access: that would be a push credential.
# Model id: run `/model --refresh` under the copilot provider on first start and copy the id
# your subscription exposes. Leave COPILOT_MODEL empty to run without Copilot.
# When set, add github.com,api.github.com,api.githubcopilot.com to EGRESS_ALLOW
# (plus api.business.githubcopilot.com or api.enterprise.githubcopilot.com for those plans).
COPILOT_MODEL=
COPILOT_GITHUB_TOKEN=

# Flowgear Builder MCP (hosted by Flowgear; OAuth sign-in once via `hermes mcp login flowgear`).
# https://<environment-hostname>/mcp/builder  -- copy the hostname from the Flowgear Console,
# use a Development environment. Add that hostname AND the Flowgear sign-in hosts shown during
# login (app.flowgear.net at least) to EGRESS_ALLOW. Empty = not configured.
FLOWGEAR_MCP_URL=

# Atlassian hosted MCP, read-only Jira + Confluence (Atlassian Cloud). Value is the full
# Authorization header. Personal scoped API token (read scopes only):
#   PowerShell: "Basic " + [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("you@company.com:ATATT3x..."))
# Service account: "Bearer <key>". Add mcp.atlassian.com to EGRESS_ALLOW. Empty = not configured.
ATLASSIAN_MCP_AUTH=

# Personal assistant profile (tasks, deadlines, meetings, reminders, morning brief). 1 = create
# the `assistant` profile with its own SOUL/memory/cron and the /opt/data/assistant workspace.
ASSISTANT_PROFILE=1
# Push channel for reminders and briefings: ntfy (phone app + web). Pick an unguessable topic.
# Public server ntfy.sh (add ntfy.sh to EGRESS_ALLOW) or your own server URL. Token optional.
NTFY_TOPIC=
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOKEN=

# Name of the replica environment's compose network (docker network ls). Only used by
# docker-compose.replica.yml. Leave blank if you have not created the replica yet.
REPLICA_NETWORK=replica_default

# Dashboard login (mandatory: Hermes refuses an unauthenticated non-loopback bind).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-me-strong
# openssl rand -base64 32  (keeps logins valid across restarts)
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-me-random

# OpenAI-compatible API on 127.0.0.1:8642 (for Open WebUI etc.). Off by default.
API_SERVER_ENABLED=false
# openssl rand -hex 32
API_SERVER_KEY=replace-me-random

# 1 = let the agent docker start/stop/restart/kill replica containers (and docker compose up/down).
# 0 = read + exec only (ps, logs, inspect, exec). Applies to both git-guard and the socket proxy.
ALLOW_CONTAINER_LIFECYCLE=0
