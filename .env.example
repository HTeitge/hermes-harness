# Copy to .env (never commit .env). Read by docker compose.

# Pin the Hermes image tag. Patch releases roll up hundreds of PRs; bump deliberately.
HERMES_TAG=0.21.5

# Host path of the repos the agent works in (bind-mounted at /workspace). Use a SEPARATE
# clone from your own working copies. Windows example: C:/work/agent-repos
WORKSPACE=C:/work/agent-repos

# Your OpenAI-compatible endpoint (llama-server, vLLM, ...). Must serve native tool calls and
# >= 64k context. The host must also appear in EGRESS_ALLOW below.
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=my-model-alias
LLM_API_KEY=replace-me

# Hostnames the agent may reach through the egress proxy, comma-separated, fnmatch globs
# allowed. Everything else is refused at the proxy (there is no other route out).
#   llm.example.com        the AI endpoint host (same host as LLM_BASE_URL)
#   host.docker.internal   services running on the laptop itself (e.g. the React dev server)
#   *.replica              every service on the replica compose network if you name it so;
#                          or list the service names: api,web,db
EGRESS_ALLOW=llm.example.com,host.docker.internal

# Name of the replica environment's compose network (docker network ls). Only used by
# docker-compose.replica.yml. Leave blank if you have not created the replica yet.
REPLICA_NETWORK=replica_default

# Dashboard login (mandatory: Hermes refuses an unauthenticated non-loopback bind).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-me-strong
# openssl rand -base64 32  (keeps logins valid across restarts)
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-me-random

# OpenAI-compatible API on 127.0.0.1:8642 (for Open WebUI etc.). Off by default.
API_SERVER_ENABLED=false
# openssl rand -hex 32
API_SERVER_KEY=replace-me-random

# 1 = let the agent docker start/stop/restart/kill replica containers (and docker compose up/down).
# 0 = read + exec only (ps, logs, inspect, exec). Applies to both git-guard and the socket proxy.
ALLOW_CONTAINER_LIFECYCLE=0
